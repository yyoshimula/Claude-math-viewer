#!/bin/bash
# claude-math: Start the Math Viewer alongside Claude Code
#
# Usage:
#   claude-math     (start viewer, then use claude normally)
#
# Reads Claude Code's JSONL transcripts directly.
# No piping, no tee, no script command needed.
#
# Opens nothing — point any browser at the printed URL
# (system browser, cmux pane via `open -a cmux $URL`, Cursor Simple Browser, etc.).

PORT="${CLAUDE_MATH_PORT:-3456}"

# Resolve symlinks so SCRIPT_DIR points to the real location of this script
# (where server.py lives), even when invoked via a symlink on PATH.
SOURCE="${BASH_SOURCE[0]:-$0}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
URL="http://localhost:$PORT"

# Start server if not already running
if ! curl -s "$URL" > /dev/null 2>&1; then
  # Detach fully (nohup + disown + redirect) so the server keeps running
  # after this shell / terminal tab is closed.
  LOG="${TMPDIR:-/tmp}/claude-math.log"
  nohup python3 "$SCRIPT_DIR/server.py" > "$LOG" 2>&1 &
  disown 2>/dev/null
  # Wait until the server actually answers (up to ~5s) instead of a fixed sleep
  for _ in $(seq 1 25); do
    curl -s "$URL" > /dev/null 2>&1 && break
    sleep 0.2
  done
fi

echo "● Claude Math Viewer running at $URL"
echo "  Open it in whichever browser you like — then run 'claude' normally."
